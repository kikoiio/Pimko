# Pimko LLM 配置 — 复制为 .env 后填入真实值；.env 已被 gitignore，不会提交。

# mock（无需联网）| openai（OpenAI 及兼容网关，如 Groq）
PIMKO_LLM_PROVIDER=mock

# API Key（仅本地 .env，切勿提交）
PIMKO_LLM_API_KEY=

# 模型名，例如 gpt-4o-mini；Groq 示例：openai/gpt-oss-120b
PIMKO_LLM_MODEL=

# 语音转写模型（provider=openai 时生效），OpenAI 默认 whisper-1；Groq 用 whisper-large-v3
PIMKO_TRANSCRIBE_MODEL=

# 可选：自定义 API 地址（代理或兼容网关）
PIMKO_LLM_BASE_URL=

# Groq 免费档完整示例（Groq 的 API 兼容 OpenAI 格式）：
# PIMKO_LLM_PROVIDER=openai
# PIMKO_LLM_API_KEY=gsk_xxx
# PIMKO_LLM_MODEL=openai/gpt-oss-120b
# PIMKO_TRANSCRIBE_MODEL=whisper-large-v3
# PIMKO_LLM_BASE_URL=https://api.groq.com/openai/v1
