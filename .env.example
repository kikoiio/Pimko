# 复制为 .env；密钥不要提交。安装版可放在 ~/.config/pimko/.env。

# 推荐用 providers.json（复制 providers.example.json）。
# 只有自定义路径或临时切换 profile 时才需要下面两行。
# PIMKO_PROVIDERS_FILE=./providers.json
# PIMKO_LLM_PROFILE=

# 没有 providers.json 时的单服务配置；mock 模式不需要填 key/model/url。
PIMKO_LLM_PROVIDER=mock
PIMKO_LLM_API_KEY=
PIMKO_LLM_MODEL=
PIMKO_LLM_BASE_URL=

# 可选：转写服务。留空跟随 LLM；LLM 服务不支持音频转写时再填。
PIMKO_TRANSCRIBE_API_KEY=
PIMKO_TRANSCRIBE_BASE_URL=
PIMKO_TRANSCRIBE_MODEL=
