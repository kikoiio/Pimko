# 复制为 .env；密钥不要提交。

# 多服务（推荐）：复制 providers.example.json 为 providers.json 后启用
# PIMKO_PROVIDERS_FILE=./providers.json
# PIMKO_LLM_PROFILE=

# 单服务（没有 providers.json 时使用）
PIMKO_LLM_PROVIDER=mock
PIMKO_LLM_API_KEY=
PIMKO_LLM_MODEL=
PIMKO_LLM_BASE_URL=
PIMKO_LLM_API_STYLE=openai-chat
PIMKO_LLM_TIMEOUT_MS=600000

# 转写；留空则跟随 LLM
PIMKO_TRANSCRIBE_API_KEY=
PIMKO_TRANSCRIBE_BASE_URL=
PIMKO_TRANSCRIBE_MODEL=

# 可选
PIMKO_DATA_DIR=
PIMKO_SELF_TEST_VIDEO=
