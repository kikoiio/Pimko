{
  "name": "pimko",
  "version": "0.1.0",
  "private": true,
  "description": "Conversational short-video editing agent",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "mcp": "tsx scripts/mcp.ts",
    "test:ui": "tsx scripts/e2e-ui.ts",
    "start": "electron-vite preview",
    "collect:ffmpeg": "tsx scripts/collect-ffmpeg.ts",
    "dist:linux": "npm run collect:ffmpeg && electron-vite build && electron-builder --linux --publish never",
    "dist:win": "npm run collect:ffmpeg && electron-vite build && electron-builder --win --publish never",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "samples": "tsx scripts/fetch-samples.ts",
    "check:fixtures": "tsx scripts/check-fixtures.ts",
    "check:editing": "tsx --test scripts/check-editing.test.ts scripts/check-undo.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "playwright": "^1.49.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true
  },
  "author": {
    "name": "kikoiio",
    "email": "kikoiio@users.noreply.github.com"
  }
}
